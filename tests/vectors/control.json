    {
      "id": "control-reset",
      "description": "RESET（既定設定に戻す）",
      "command": {
        "opcode": "RESET"
      },
      "hex": "7f",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "RESET"
        }
      }
    },
    {
      "id": "control-unknown-opcode-auth",
      "description": "予約 opcode 0x10（AUTH、v1 では未知 = 無視して last_error=1）",
      "command": null,
      "hex": "10",
      "expect": {
        "valid": false,
        "error": "unknown_opcode",
        "last_error": 1
      }
    },
    {
      "id": "control-unknown-opcode-ff",
      "description": "未知 opcode 0xFF（無視して last_error=1）",
      "command": null,
      "hex": "ff",
      "expect": {
        "valid": false,
        "error": "unknown_opcode",
        "last_error": 1
      }
    },
    {
      "id": "control-bad-length-start",
      "description": "START の長さ不正（2 bytes = 無視して last_error=2）",
      "command": null,
      "hex": "01e8",
      "expect": {
        "valid": false,
        "error": "bad_length",
        "last_error": 2
      }
    },
    {
      "id": "control-bad-length-stop",
      "description": "STOP の長さ不正（2 bytes = 無視して last_error=2）",
      "command": null,
      "hex": "0200",
      "expect": {
        "valid": false,
        "error": "bad_length",
        "last_error": 2
      }
    },
    {
      "id": "control-bad-length-set-extended",
      "description": "SET_EXTENDED の長さ不正（3 bytes = 無視して last_error=2）",
      "command": null,
      "hex": "050100",
      "expect": {
        "valid": false,
        "error": "bad_length",
        "last_error": 2
      }
    }
  ]
}
