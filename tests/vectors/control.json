{
  "schema": "p2pgps-protocol/test-vectors/control@1",
  "kind": "control",
  "source": "spec/protocol-v1.md §5, §10",
  "notes": "command は受信側が書き込む値。hex は 1〜3 bytes の期待値。",
  "vectors": [
    {
      "id": "control-start-default",
      "description": "START interval_ms=0（既定値 1000 として送信される）",
      "command": {
        "opcode": "START",
        "interval_ms": 0
      },
      "hex": "01e803",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "START",
          "interval_ms": 1000,
          "normalized_interval_ms": 1000
        }
      }
    },
    {
      "id": "control-start-1000",
      "description": "START interval_ms=1000",
      "command": {
        "opcode": "START",
        "interval_ms": 1000
      },
      "hex": "01e803",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "START",
          "interval_ms": 1000,
          "normalized_interval_ms": 1000
        }
      }
    },
    {
      "id": "control-start-min",
      "description": "START interval_ms=100（下限）",
      "command": {
        "opcode": "START",
        "interval_ms": 100
      },
      "hex": "016400",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "START",
          "interval_ms": 100,
          "normalized_interval_ms": 100
        }
      }
    },
    {
      "id": "control-start-max",
      "description": "START interval_ms=60000（上限）",
      "command": {
        "opcode": "START",
        "interval_ms": 60000
      },
      "hex": "0160ea",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "START",
          "interval_ms": 60000,
          "normalized_interval_ms": 60000
        }
      }
    },
    {
      "id": "control-start-too-small",
      "description": "START interval_ms=50（範囲外 → 既定値 1000 にクランプして送信）",
      "command": {
        "opcode": "START",
        "interval_ms": 50
      },
      "hex": "01e803",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "START",
          "interval_ms": 1000,
          "normalized_interval_ms": 1000
        }
      }
    },
    {
      "id": "control-start-too-large",
      "description": "START interval_ms=60001（範囲外 → 既定値 1000 にクランプして送信）",
      "command": {
        "opcode": "START",
        "interval_ms": 60001
      },
      "hex": "01e803",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "START",
          "interval_ms": 1000,
          "normalized_interval_ms": 1000
        }
      }
    },
    {
      "id": "control-stop",
      "description": "STOP（payload なし）",
      "command": {
        "opcode": "STOP"
      },
      "hex": "02",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "STOP"
        }
      }
    },
    {
      "id": "control-set-interval",
      "description": "SET_INTERVAL interval_ms=500",
      "command": {
        "opcode": "SET_INTERVAL",
        "interval_ms": 500
      },
      "hex": "03f401",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "SET_INTERVAL",
          "interval_ms": 500,
          "normalized_interval_ms": 500
        }
      }
    },
    {
      "id": "control-request-fix",
      "description": "REQUEST_FIX（payload なし）",
      "command": {
        "opcode": "REQUEST_FIX"
      },
      "hex": "04",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "REQUEST_FIX"
        }
      }
    },
    {
      "id": "control-set-extended-on",
      "description": "SET_EXTENDED enabled=1",
      "command": {
        "opcode": "SET_EXTENDED",
        "enabled": true
      },
      "hex": "0501",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "SET_EXTENDED",
          "enabled": true
        }
      }
    },
    {
      "id": "control-set-extended-off",
      "description": "SET_EXTENDED enabled=0",
      "command": {
        "opcode": "SET_EXTENDED",
        "enabled": false
      },
      "hex": "0500",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "SET_EXTENDED",
          "enabled": false
        }
      }
    },
    {
      "id": "control-reset",
      "description": "RESET（既定設定に戻す）",
      "command": {
        "opcode": "RESET"
      },
      "hex": "7f",
      "expect": {
        "valid": true,
        "decoded": {
          "opcode": "RESET"
        }
      }
    },
    {
      "id": "control-unknown-opcode-auth",
      "description": "予約 opcode 0x10（AUTH、v1 では未知 = 無視して last_error=1）",
      "command": null,
      "hex": "10",
      "expect": {
        "valid": false,
        "error": "unknown_opcode",
        "last_error": 1
      }
    },
    {
      "id": "control-unknown-opcode-ff",
      "description": "未知 opcode 0xFF（無視して last_error=1）",
      "command": null,
      "hex": "ff",
      "expect": {
        "valid": false,
        "error": "unknown_opcode",
        "last_error": 1
      }
    },
    {
      "id": "control-bad-length-start",
      "description": "START の長さ不正（2 bytes = 無視して last_error=2）",
      "command": null,
      "hex": "01e8",
      "expect": {
        "valid": false,
        "error": "bad_length",
        "last_error": 2
      }
    },
    {
      "id": "control-bad-length-stop",
      "description": "STOP の長さ不正（2 bytes = 無視して last_error=2）",
      "command": null,
      "hex": "0200",
      "expect": {
        "valid": false,
        "error": "bad_length",
        "last_error": 2
      }
    },
    {
      "id": "control-bad-length-set-extended",
      "description": "SET_EXTENDED の長さ不正（3 bytes = 無視して last_error=2）",
      "command": null,
      "hex": "050100",
      "expect": {
        "valid": false,
        "error": "bad_length",
        "last_error": 2
      }
    }
  ]
}
